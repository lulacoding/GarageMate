[
  {
    "id": "TC001",
    "title": "App loads to login placeholder without crashing (baseline smoke)",
    "description": "Verifies the app can load a concrete route and render placeholder UI without an error screen.",
    "category": "Firebase Initialisation",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to \"/(auth)/login\""
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/(auth)/login\""
      },
      {
        "type": "assertion",
        "description": "Verify page title contains \"GarageMate\""
      },
      {
        "type": "assertion",
        "description": "Verify text \"Login\" is visible"
      }
    ]
  },
